  "simple.html": "<!doctype html>\n<html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head>\n<body style=\"margin:0;background:#f4f4f5;font-family:Arial, Helvetica, sans-serif\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Un preheader de prueba</div>\n  <div style=\"max-width:600px;margin:0 auto;padding:24px 16px\">\n    <!-- Encabezado de marca -->\n    <div style=\"text-align:center;padding:8px 0 16px\">\n      <span style=\"font-size:18px;font-weight:700;letter-spacing:1px;color:#171717\">MARCA DE PRUEBA</span>\n      <div style=\"width:40px;height:3px;background:#f59e0b;margin:10px auto 0;border-radius:2px\"></div>\n    </div>\n    <!-- Cuerpo -->\n    <div style=\"background:#ffffff;border:1px solid #ececec;border-radius:12px;overflow:hidden\">\n      <div style=\"height:12px\"></div>\n      <div style=\"padding:0 32px\"><h1 style=\"margin:16px 0;font-size:26px;line-height:1.25;color:#171717;text-align:left\">Hola</h1></div>\n<div style=\"padding:0 32px\"><p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;color:#404040;text-align:left\">Un párrafo<br>con salto.</p></div>\n<div style=\"padding:0 32px\"><div style=\"text-align:left;margin:8px 0 20px\"><a href=\"https://ejemplo.com\" style=\"display:inline-block;padding:14px 32px;font-size:16px;font-weight:600;color:#171717;background:#f59e0b;border-radius:8px;text-decoration:none\">Comprar</a></div></div>\n      <div style=\"height:16px\"></div>\n    </div>\n    <!-- Footer -->\n    <div style=\"text-align:center;color:#a3a3a3;font-size:12px;line-height:1.6;margin-top:20px\">\n      Marca de Prueba · Calle Falsa 123, CABA<br>\n      <a href=\"https://ejemplo.com/baja?token=abc\" style=\"color:#a3a3a3\">Desuscribirme</a>\n    </div>\n  </div>\n</body></html>",
