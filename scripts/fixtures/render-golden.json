align=\"center\" style=\"padding:24px 16px\">\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"m-full\" style=\"width:600px;max-width:100%\">\n      <tr><td>\n    <!-- Encabezado de marca (bloque; se puede editar o borrar) -->\n    <div style=\"text-align:center;padding:12px 0px\"><span style=\"font-size:18px;font-weight:700;letter-spacing:1px;color:#171717\">MARCA DE PRUEBA</span><div style=\"width:40px;height:3px;background:#f59e0b;margin:10px auto 0 auto;border-radius:2px\"></div></div>\n    <!-- Cuerpo -->\n    <div style=\"background:#ffffff;border:1px solid #ececec;border-radius:12px;overflow:hidden\">\n      <div style=\"height:12px\"></div>\n      <div class=\"m-pad\" style=\"padding:0 32px\"><h1 class=\"m-h1\" style=\"margin:16px 0;font-size:26px;line-height:1.25;color:#171717;text-align:left\">Hola</h1></div>\n<div class=\"m-pad\" style=\"padding:0 32px\"><p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;color:#404040;text-align:left\">Un párrafo<br>con salto.</p></div>\n<div class=\"m-pad\" style=\"padding:0 32px\"><div style=\"text-align:left;margin:8px 0 20px\"><!--[if mso]>\n<v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://ejemplo.com\" style=\"height:47px;v-text-anchor:middle;width:133px\" arcsize=\"34%\" stroke=\"f\" fillcolor=\"#f59e0b\">\n<w:anchorlock/>\n<center style=\"color:#171717;font-family:Arial, Helvetica, sans-serif;font-size:16px;font-weight:600\">Comprar</center>\n</v:roundrect>\n<![endif]--><!--[if !mso]><!--><a href=\"https://ejemplo.com\" style=\"display:inline-block;padding:14px 32px;font-size:16px;font-weight:600;color:#171717;background:#f59e0b;border-radius:8px;text-decoration:none\">Comprar</a><!--<![endif]--></div></div>\n      <div style=\"height:16px\"></div>\n    </div>\n    <!-- Footer -->\n    <div style=\"text-align:center;color:#a3a3a3;font-size:12px;line-height:1.6;margin-top:20px\">\n   