  "simple.html": "<!doctype html>\n<html lang=\"es\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<!--[if mso]>\n<xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>\n<![endif]-->\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<style>\n  body{margin:0;padding:0;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}\n  table{border-collapse:collapse}\n  img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic}\n  /* iOS autolinkea la dirección postal del pie y la pinta de azul. */\n  a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;font-size:inherit!important;font-family:inherit!important;font-weight:inherit!important;line-height:inherit!important}\n  .d-hide{display:none;mso-hide:all}\n  @media only screen and (max-width:600px){\n    .m-full{width:100%!important}\n    .m-col{display:block!important;width:100%!important;max-width:100%!important}\n    .m-pad{padding-left:20px!important;padding-right:20px!important}\n    .m-h1{font-size:22px!important}\n    .m-h2{font-size:19px!important}\n    .m-hide{display:none!important;max-height:0!important;overflow:hidden!important;mso-hide:all}\n    .d-hide{display:block!important;mso-hide:none}\n  }\n</style>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f4f5;font-family:Arial, Helvetica, sans-serif\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0\">Un preheader de prueba</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f4f4f5;width:100%\">\n  <tr><td align=\"center\" style=\"padding:24px 16px\">\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"m-full\" style=\"width:600px;max-width:100%\">\n      <tr><td>\n    <!-- Encabezado de marca -->\n    <div style=\"text-align:center;padding:8px 0 16px\">\n      <span style=\"font-size:18px;font-weight:700;letter-spacing:1px;color:#171717\">MARCA DE PRUEBA</span>\n      <div style=\"width:40px;height:3px;background:#f59e0b;margin:10px auto 0;border-radius:2px\"></div>\n    </div>\n    <!-- Cuerpo -->\n    <div style=\"background:#ffffff;border:1px solid #ececec;border-radius:12px;overflow:hidden\">\n      <div style=\"height:12px\"></div>\n      <div class=\"m-pad\" style=\"padding:0 32px\"><h1 class=\"m-h1\" style=\"margin:16px 0;font-size:26px;line-height:1.25;color:#171717;text-align:left\">Hola</h1></div>\n<div class=\"m-pad\" style=\"padding:0 32px\"><p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;color:#404040;text-align:left\">Un párrafo<br>con salto.</p></div>\n<div class=\"m-pad\" style=\"padding:0 32px\"><div style=\"text-align:left;margin:8px 0 20px\"><!--[if mso]>\n<v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"https://ejemplo.com\" style=\"height:47px;v-text-anchor:middle;width:133px\" arcsize=\"34%\" stroke=\"f\" fillcolor=\"#f59e0b\">\n<w:anchorlock/>\n<center style=\"color:#171717;font-family:Arial, Helvetica, sans-serif;font-size:16px;font-weight:600\">Comprar</center>\n</v:roundrect>\n<![endif]--><!--[if !mso]><!--><a href=\"https://ejemplo.com\" style=\"display:inline-block;padding:14px 32px;font-size:16px;font-weight:600;color:#171717;background:#f59e0b;border-radius:8px;text-decoration:none\">Comprar</a><!--<![endif]--></div></div>\n      <div style=\"height:16px\"></div>\n    </div>\n    <!-- Footer -->\n    <div style=\"text-align:center;color:#a3a3a3;font-size:12px;line-height:1.6;margin-top:20px\">\n      Marca de Prueba · Calle Falsa 123, CABA<br>\n      <a href=\"https://ejemplo.com/baja?token=abc\" style=\"color:#a3a3a3\">Desuscribirme</a>\n    </div>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>",
