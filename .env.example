# ── Base de datos (Neon) ────────────────────────────────────────
# DATABASE_URL = connection string POOLED de Neon (para runtime)
# DIRECT_URL   = connection string DIRECTA de Neon (para migraciones / db push)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Tiendanube (OAuth) ──────────────────────────────────────────
TN_CLIENT_ID=""
TN_CLIENT_SECRET=""
TN_REDIRECT_URI="http://localhost:3000/api/tn/callback"

# ── Amazon SES (envío) ──────────────────────────────────────────
# Fallback: si usamos Resend en vez de SES, se reemplaza por RESEND_API_KEY
AWS_REGION="sa-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET="areben-mailer"

# ── App ─────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Acceso a la app (Basic Auth interino) ──────────────────────
# Si están vacías, no se bloquea (dev local). En producción, siempre setearlas.
APP_USER=""
APP_PASSWORD=""

# Gate del envío masivo a la lista real. Vale para CUALQUIER proveedor, no solo
# SES: se pone en "true" recién cuando el proveedor activo esté aprobado para
# producción. Cualquier otro valor (o la env ausente) = bloqueado.
ENVIO_REAL="false"

# Nombre viejo del gate de arriba. Solo se lee si ENVIO_REAL no está definida;
# se puede borrar en cuanto ENVIO_REAL esté cargada en Vercel y en el .env local.
SES_SANDBOX="true"

CRON_SECRET=""
